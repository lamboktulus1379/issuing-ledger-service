[mysqld]
# A stable, unique server ID is required for binlog replication clients.
server-id=184054

# Debezium reads row changes from the binary log.
log_bin=mariadb-bin
binlog_format=ROW
binlog_row_image=FULL

# Keep transaction metadata and GTIDs available for connector recovery.
binlog_expire_logs_seconds=604800
gtid_strict_mode=ON
log_slave_updates=ON

# Debezium requires enough metadata for reliable schema history and snapshots.
binlog_checksum=NONE
character_set_server=utf8mb4
collation-server=utf8mb4_unicode_ci